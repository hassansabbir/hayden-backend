NODE_ENV=development
PORT=5000

DATABASE_URL=mongodb://localhost:27017/tea-it-up

JWT_ACCESS_SECRET=replace-with-a-long-random-string
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=replace-with-a-different-long-random-string
JWT_REFRESH_EXPIRES_IN=30d

BCRYPT_SALT_ROUNDS=12

COOKIE_SECRET=replace-with-a-long-random-string

CLIENT_WEBSITE_URL=http://localhost:3000
CLIENT_DASHBOARD_URL=http://localhost:3001

OTP_EXPIRES_IN_MINUTES=10
OTP_MAX_ATTEMPTS=5

MEDIA_PROVIDER=LOCAL
UPLOAD_DIR=uploads
MAX_UPLOAD_SIZE_MB=5

# Used only if MEDIA_PROVIDER=CLOUDINARY in the future
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

SUPER_ADMIN_EMAIL=
SUPER_ADMIN_PASSWORD=

# Nodemailer / Gmail SMTP — used by the "Send a Message" contact form.
# SMTP_USER is the Gmail address; SMTP_PASS is a Gmail App Password
# (Google Account > Security > 2-Step Verification > App passwords), not
# the regular account password.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Tea It Up <no-reply@teaitup.com>"
# Inbox that receives contact-form submissions.
CONTACT_RECEIVER_EMAIL=

