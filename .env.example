NODE_ENV=production
PORT=5000

# MongoDB Atlas connection string (local URI will NOT work on Vercel)
DATABASE_URL=mongodb+srv://<user>:<password>@cluster.mongodb.net/tea-it-up?retryWrites=true&w=majority

# JWT — use long, random strings (openssl rand -base64 48)
JWT_ACCESS_SECRET=replace-with-a-long-random-string
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=replace-with-a-different-long-random-string
JWT_REFRESH_EXPIRES_IN=30d

BCRYPT_SALT_ROUNDS=12

COOKIE_SECRET=replace-with-a-long-random-string

# Deployed frontend URLs — set these AFTER deploying website and dashboard
CLIENT_WEBSITE_URL=https://your-website.vercel.app
CLIENT_DASHBOARD_URL=https://your-dashboard.vercel.app

OTP_EXPIRES_IN_MINUTES=10
OTP_MAX_ATTEMPTS=5

# IMPORTANT: LOCAL storage does NOT work on Vercel (ephemeral filesystem).
# You MUST use CLOUDINARY in production.
MEDIA_PROVIDER=CLOUDINARY
UPLOAD_DIR=uploads
MAX_UPLOAD_SIZE_MB=5

# Cloudinary credentials (required when MEDIA_PROVIDER=CLOUDINARY)
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret

# Super admin seeded on first cold start (optional but recommended)
SUPER_ADMIN_EMAIL=admin@yourdomain.com
SUPER_ADMIN_PASSWORD=a-strong-password

# Nodemailer / Gmail SMTP
# SMTP_PASS must be a Gmail App Password (not your regular password).
# Google Account → Security → 2-Step Verification → App passwords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-gmail@gmail.com
SMTP_PASS=your-app-password
MAIL_FROM="Tee It Up <no-reply@teeitup.com>"
CONTACT_RECEIVER_EMAIL=your-inbox@gmail.com
